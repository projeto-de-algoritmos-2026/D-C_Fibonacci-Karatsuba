{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake --preset debug",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake --build --preset debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "CMake: Configure",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CTest: Rodar testes",
      "type": "shell",
      "command": "ctest --preset debug",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "CMake: Build",
      "problemMatcher": []
    }
  ]
}
